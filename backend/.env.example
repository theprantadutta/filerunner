# PostgreSQL Configuration (for local development)
# For Docker, these are set in the root .env file
POSTGRES_USER=filerunner
POSTGRES_PASSWORD=filerunner_password
POSTGRES_DB=filerunner

# Database Connection URL
# For local development: use localhost
# For Docker: this is constructed in docker-compose.yml
DATABASE_URL=postgresql://filerunner:filerunner_password@localhost:5432/filerunner

# JWT Configuration
# REQUIRED: at least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# Server Configuration
SERVER_PORT=8000
SERVER_HOST=0.0.0.0

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Storage Configuration
STORAGE_PATH=./storage
MAX_FILE_SIZE=104857600  # 100MB in bytes

# Feature Flags
ALLOW_SIGNUP=false

# Admin User (created on first startup)
# NOTE: Admin must change password on first login
ADMIN_EMAIL=admin@example.com
# Required on first startup: at least 12 characters, not a default value
ADMIN_PASSWORD=

# Logging
RUST_LOG=info,filerunner_backend=debug
