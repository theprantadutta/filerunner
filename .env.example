# FileRunner backend settings, read by compose.yml (env_file: .env)
# Copy to .env and fill in. .env is gitignored.

# PostgreSQL connection. "postgres" is the shared Postgres container on the proxy network.
DATABASE_URL=postgresql://postgres:your-db-password@postgres:5432/filerunner

# REQUIRED. Signs every login session. Generate with: openssl rand -hex 32
# The server refuses to start without it, or with a short or example value.
JWT_SECRET=

# The frontend's address, so browsers may call the API from it
CORS_ORIGINS=https://files.pranta.dev

# First admin account, created on first startup only (ignored once an admin exists).
# ADMIN_PASSWORD must be at least 12 characters and not a default value.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Let anyone with the URL create an account (default: false)
# ALLOW_SIGNUP=false

# Largest accepted upload in bytes (default: 524288000 = 500 MB)
# MAX_FILE_SIZE=524288000

# Name of the Docker volume holding uploaded files (default: filerunner_file_storage)
# FILE_STORAGE_VOLUME=filerunner_file_storage

# Log detail (default: info,sqlx=warn,tower_http=warn). "warn" shows only problems.
# RUST_LOG=info
